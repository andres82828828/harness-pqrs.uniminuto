# Copia este archivo como .env y cambia las contraseñas. El .env NO se sube a GitHub.
# Sin espacios al inicio de las líneas ni alrededor del "=".

# ---------- Clasificador ----------
CLASSIFIER=ollama
OLLAMA_MODEL=llama3.2:3b
ANTHROPIC_API_KEY=

# ---------- Data lake (RustFS) ----------
MINIO_ROOT_USER=pqrsadmin
MINIO_ROOT_PASSWORD=cambiar_esto

# ---------- Base de datos ----------
POSTGRES_USER=pqrs
POSTGRES_PASSWORD=cambiar_esto

# ---------- Aplicación web ----------
# Correos con rol de administrador (separados por coma)
CORREOS_ADMIN=
# Cuentas de demostración que no existen de verdad: su código llega al buzón local (http://localhost:8025)
CORREOS_DEMO=admin.demo@uniminuto.edu.co
# Dominios de correo que pueden ingresar
DOMINIOS_PERMITIDOS=uniminuto.edu.co
# Clave para firmar las sesiones (cualquier texto largo y aleatorio)
SECRET_KEY=

# ---------- Correo (opcional) ----------
# Sin SMTP_PASSWORD, los códigos de acceso llegan al buzón de prueba http://localhost:8025
# Para enviarlos al correo real con Gmail: activa la verificación en dos pasos de la cuenta y
# crea una CONTRASEÑA DE APLICACIÓN (16 letras). No uses la contraseña normal de la cuenta.
# Si el envío real falla, el código queda en el buzón de prueba y la página lo avisa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
