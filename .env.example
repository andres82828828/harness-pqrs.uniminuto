# Copia este archivo como .env y cambia las contraseñas. El .env NO se sube a GitHub.
# Sin espacios al inicio de las líneas ni alrededor del "=".

# ---------- Clasificador ----------
CLASSIFIER=ollama
OLLAMA_MODEL=llama3.2:3b
ANTHROPIC_API_KEY=

# ---------- Data lake (RustFS) ----------
MINIO_ROOT_USER=pqrsadmin
MINIO_ROOT_PASSWORD=cambiar_esto

# ---------- Base de datos ----------
POSTGRES_USER=pqrs
POSTGRES_PASSWORD=cambiar_esto

# ---------- Aplicación web ----------
# Correos con rol de administrador (separados por coma)
CORREOS_ADMIN=
# Dominios de correo que pueden ingresar
DOMINIOS_PERMITIDOS=uniminuto.edu.co
# Clave para firmar las sesiones (cualquier texto largo y aleatorio)
SECRET_KEY=

# ---------- Correo (opcional) ----------
# Vacío = los códigos de acceso llegan al buzón de prueba http://localhost:8025
# Para enviarlos al correo real, por ejemplo con Gmail y una contraseña de aplicación:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=cuenta@gmail.com
# SMTP_PASSWORD=contraseña_de_aplicacion
# SMTP_FROM=cuenta@gmail.com
